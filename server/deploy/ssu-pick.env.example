# /etc/ssu-pick.env  — 서버 설정 (이 파일은 GitHub·카톡에 올리지 않는다)
# = 양옆에 띄어쓰기 없이, 따옴표 없이 적는다
GEMINI_API_KEY=여기에_AI_Studio_키
GEMINI_MODEL=gemini-3.5-flash-lite
ADMIN_KEY=여기에_길고_아무도_모르는_값
# 수집 시각 (한국 시간). 로컬 실습의 30분마다 대신 하루 6번
COLLECT_HOURS=8,11,14,17,20,23
COLLECT_CATCH=10
COLLECT_DETAIL=10
COLLECT_PAGES=1
COLLECT_AI=1
AI_IMAGES=1
