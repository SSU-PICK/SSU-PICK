[Unit]
Description=SSU:Pick API server (FastAPI + 자동 수집)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ssu-pick/server-lab
EnvironmentFile=/etc/ssu-pick.env
ExecStart=/home/ubuntu/ssu-pick/server-lab/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
